@model Smart_Medical_Appointment_System.Models.Patient

@{
    ViewData["Title"] = "Patient Details";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h3 class="fw-bold mb-0">Patient Details</h3>
</div>

<div class="card shadow-sm p-4" style="max-width: 600px;">

    <div class="d-flex align-items-center gap-3 mb-4">
        <div style="width:60px; height:60px; background:#1a1f36;
            border-radius:50%; display:flex; align-items:center;
            justify-content:center;">
            <i class="bi bi-person text-white fs-4"></i>
        </div>
        <div>
            <h5 class="fw-bold mb-0">@Model.Name</h5>
            <span class="text-muted small">@(Model.Email ?? "No Email")</span>
        </div>
    </div>

    <hr />

    <div class="row mb-3">
        <div class="col-4 text-muted fw-semibold">الاسم الكامل</div>
        <div class="col-8">@Model.Name</div>
    </div>

    <div class="row mb-3">
        <div class="col-4 text-muted fw-semibold">رقم الهاتف</div>
        <div class="col-8">@(Model.Phone ?? "غير متاح")</div>
    </div>

    <div class="row mb-3">
        <div class="col-4 text-muted fw-semibold">الإيميل</div>
        <div class="col-8">@(Model.Email ?? "غير متاح")</div>
    </div>

    <div class="row mb-4">
        <div class="col-4 text-muted fw-semibold">عدد المواعيد</div>
        <div class="col-8">
            <span class="badge bg-success">
                @(Model.Appointments?.Count ?? 0) موعد
            </span>
        </div>
    </div>

    <hr />

    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-warning px-4">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary px-4">
            Back to List
        </a>
    </div>
</div>