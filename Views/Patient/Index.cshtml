@model List<Smart_Medical_Appointment_System.Models.Patient>

@{
    ViewData["Title"] = "Patients List";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold">Patients List</h3>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Create New
    </a>
</div>

<div class="card shadow-sm">
    <table class="table table-hover mb-0">
        <thead style="background:#1a1f36; color:white;">
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var patient in Model)
            {
                <tr>
                    <td>@patient.Name</td>
                    <td>@(patient.Phone ?? "غير متاح")</td>
                    <td>@(patient.Email ?? "غير متاح")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@patient.Id"
                               class="btn btn-sm btn-outline-info" title="Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@patient.Id"
                               class="btn btn-sm btn-outline-warning" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@patient.Id"
                               class="btn btn-sm btn-outline-danger" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>