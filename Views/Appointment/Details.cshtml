@model Smart_Medical_Appointment_System.Models.Appointment

@{
    ViewData["Title"] = "Appointment Details";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h3 class="fw-bold mb-0">Appointment Details</h3>
</div>

<div class="card shadow-sm p-4" style="max-width: 600px;">

    <div class="d-flex align-items-center gap-3 mb-4">
        <div style="width:60px; height:60px; background:#1a1f36;
            border-radius:50%; display:flex; align-items:center;
            justify-content:center;">
            <i class="bi bi-calendar-check text-white fs-4"></i>
        </div>
        <div>
            <h5 class="fw-bold mb-0">@Model.Doctor?.Name</h5>
            <span class="badge
                @(Model.Status == "Confirmed" ? "bg-success" :
                                    Model.Status == "Cancelled" ? "bg-danger" :
                                    Model.Status == "Completed" ? "bg-info" : "bg-warning")">
                @Model.Status
            </span>
        </div>
    </div>

    <hr />

    <div class="row mb-3">
        <div class="col-4 text-muted fw-semibold">الدكتور</div>
        <div class="col-8">@Model.Doctor?.Name</div>
    </div>

    <div class="row mb-3">
        <div class="col-4 text-muted fw-semibold">التخصص</div>
        <div class="col-8">@Model.Doctor?.Specialization</div>
    </div>

    <div class="row mb-3">
        <div class="col-4 text-muted fw-semibold">المريض</div>
        <div class="col-8">@Model.Patient?.Name</div>
    </div>

    <div class="row mb-3">
        <div class="col-4 text-muted fw-semibold">التاريخ</div>
        <div class="col-8">@Model.AppointmentDate.ToString("dd/MM/yyyy hh:mm tt")</div>
    </div>

    <div class="row mb-3">
        <div class="col-4 text-muted fw-semibold">الحالة</div>
        <div class="col-8">
            <span class="badge
                @(Model.Status == "Confirmed" ? "bg-success" :
                                    Model.Status == "Cancelled" ? "bg-danger" :
                                    Model.Status == "Completed" ? "bg-info" : "bg-warning")">
                @Model.Status
            </span>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-4 text-muted fw-semibold">ملاحظات</div>
        <div class="col-8">@(Model.Notes ?? "لا يوجد")</div>
    </div>

    <hr />

    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-warning px-4">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary px-4">
            Back to List
        </a>
    </div>
</div>