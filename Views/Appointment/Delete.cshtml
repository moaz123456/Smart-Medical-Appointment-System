@model Smart_Medical_Appointment_System.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h3 class="fw-bold mb-0">Delete Appointment</h3>
</div>

<div class="card shadow-sm p-4" style="max-width: 600px;">
    <div class="alert alert-danger d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>هل انت متأكد إنك عاوز تحذف الموعد ده؟</span>
    </div>

    <div class="mb-3">
        <p><span class="fw-semibold">الدكتور:</span> @Model.Doctor?.Name</p>
        <p><span class="fw-semibold">المريض:</span> @Model.Patient?.Name</p>
        <p><span class="fw-semibold">التاريخ:</span> @Model.AppointmentDate.ToString("dd/MM/yyyy hh:mm tt")</p>
        <p>
            <span class="fw-semibold">الحالة:</span>
            <span class="badge
                @(Model.Status == "Confirmed" ? "bg-success" :
                                    Model.Status == "Cancelled" ? "bg-danger" :
                                    Model.Status == "Completed" ? "bg-info" : "bg-warning")">
                @Model.Status
            </span>
        </p>
        <p><span class="fw-semibold">ملاحظات:</span> @(Model.Notes ?? "لا يوجد")</p>
    </div>

    <form asp-action="DeleteConfirmed"
          asp-controller="Appointment"
          asp-route-id="@Model.Id"
          method="post">
        @Html.AntiForgeryToken()
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger px-4">
                <i class="bi bi-trash"></i> نعم، احذف
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">إلغاء</a>
        </div>
    </form>
</div>