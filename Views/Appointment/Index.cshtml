@model List<Appointment>

@{
    ViewData["Title"] = "Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold">Appointments</h3>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Appointment
    </a>
</div>

<table class="table table-bordered table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Doctor</th>
            <th>Patient</th>
            <th>Date</th>
            <th>Status</th>
            <th>Notes</th>
            <th style="width:180px;">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Doctor?.Name</td>
                <td>@item.Patient?.Name</td>
                <td>@item.AppointmentDate.ToString("yyyy-MM-dd HH:mm")</td>

                <td>
                    <span class="badge
                        @(item.Status == "Completed" ? "bg-success" :
                                                    item.Status == "Cancelled" ? "bg-danger" :
                                                    item.Status == "Confirmed" ? "bg-primary" :
                                                    "bg-warning")">
                        @item.Status
                    </span>
                </td>

                <td>@item.Notes</td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id"
                       class="btn btn-sm btn-info text-white">👁</a>

                    <a asp-action="Edit" asp-route-id="@item.Id"
                       class="btn btn-sm btn-warning">✏️</a>

                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-sm btn-danger">🗑</a>
                </td>
            </tr>
        }
    </tbody>
</table>