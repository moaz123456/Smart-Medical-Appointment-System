@{
    ViewData["Title"] = "Dashboard";
}

<h3 class="fw-bold mb-4">Dashboard</h3>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm p-3 border-0"
             style="border-left: 4px solid #1a1f36 !important;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1 small">Total Doctors</p>
                    <h3 class="fw-bold mb-0">@ViewBag.TotalDoctors</h3>
                </div>
                <i class="bi bi-person-badge fs-2 text-primary"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3 border-0"
             style="border-left: 4px solid #198754 !important;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1 small">Total Patients</p>
                    <h3 class="fw-bold mb-0">@ViewBag.TotalPatients</h3>
                </div>
                <i class="bi bi-people fs-2 text-success"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3 border-0"
             style="border-left: 4px solid #0dcaf0 !important;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1 small">Total Appointments</p>
                    <h3 class="fw-bold mb-0">@ViewBag.TotalAppointments</h3>
                </div>
                <i class="bi bi-calendar-check fs-2 text-info"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3 border-0"
             style="border-left: 4px solid #ffc107 !important;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1 small">Pending</p>
                    <h3 class="fw-bold mb-0">@ViewBag.Pending</h3>
                </div>
                <i class="bi bi-clock fs-2 text-warning"></i>
            </div>
        </div>
    </div>
</div>

<!-- Status Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm p-3 border-0 text-center">
            <p class="text-muted mb-1 small">Confirmed</p>
            <h4 class="fw-bold text-success">@ViewBag.Confirmed</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm p-3 border-0 text-center">
            <p class="text-muted mb-1 small">Completed</p>
            <h4 class="fw-bold text-info">@ViewBag.Completed</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm p-3 border-0 text-center">
            <p class="text-muted mb-1 small">Cancelled</p>
            <h4 class="fw-bold text-danger">@ViewBag.Cancelled</h4>
        </div>
    </div>
</div>

<!-- Recent Appointments -->
<div class="card shadow-sm">
    <div class="card-header fw-bold" style="background:#1a1f36; color:white;">
        <i class="bi bi-clock-history"></i> Recent Appointments
    </div>
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Doctor</th>
                <th>Patient</th>
                <th>Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in ViewBag.RecentAppointments)
            {
                <tr>
                    <td>@a.Doctor?.Name</td>
                    <td>@a.Patient?.Name</td>
                    <td>@a.AppointmentDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        <span class="badge
                            @(a.Status == "Confirmed" ? "bg-success" :
                                                            a.Status == "Cancelled" ? "bg-danger" :
                                                            a.Status == "Completed" ? "bg-info" : "bg-warning")">
                            @a.Status
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>