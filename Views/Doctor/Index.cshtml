@model List<Smart_Medical_Appointment_System.Models.Doctor>

@{
    ViewData["Title"] = "Doctors List";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold">Doctors List</h3>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Create New
    </a>
</div>

<!-- Filter -->
<div class="d-flex align-items-center gap-2 mb-3">
    <label class="fw-semibold">Filter by Specialization:</label>
    <select id="filterSelect" class="form-select w-auto">
        <option value="All">All</option>
        @foreach (var spec in Model.Select(d => d.Specialization).Distinct())
        {
            <option value="@spec">@spec</option>
        }
    </select>
    <button class="btn btn-primary" onclick="filterTable()">Filter</button>
</div>

<!-- Table -->
<div class="card shadow-sm">
    <table class="table table-hover mb-0" id="doctorTable">
        <thead style="background:#1a1f36; color:white;">
            <tr>
                <th>Name</th>
                <th>Specialization</th>
                <th>Phone</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var doctor in Model)
            {
                <tr data-spec="@doctor.Specialization">
                    <td>@doctor.Name</td>
                    <td>@doctor.Specialization</td>
                    <td>@doctor.Phone</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@doctor.Id"
                               class="btn btn-sm btn-outline-info" title="Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@doctor.Id"
                               class="btn btn-sm btn-outline-warning" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@doctor.Id"
                               class="btn btn-sm btn-outline-danger" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        function filterTable() {
            const selected = document.getElementById('filterSelect').value;
            const rows = document.querySelectorAll('#doctorTable tbody tr');
            rows.forEach(row => {
                if (selected === 'All' || row.dataset.spec === selected) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>
}