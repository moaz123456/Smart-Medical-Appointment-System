@model Smart_Medical_Appointment_System.Models.Doctor

@{
    ViewData["Title"] = "Create Doctor";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h3 class="fw-bold mb-0">Create New Doctor</h3>
</div>

<div class="card shadow-sm p-4" style="max-width: 600px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-semibold"></label>
            <input asp-for="Name" class="form-control" placeholder="Dr. Mohamed Hassan" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Specialization" class="form-label fw-semibold"></label>
            <select asp-for="Specialization" class="form-select">
                <option value="">-- Select Specialization --</option>
                <option>جراحة</option>
                <option>باطنة</option>
                <option>أطفال</option>
                <option>أنف وأذن</option>
                <option>عيون</option>
                <option>قلب</option>
                <option>عظام</option>
            </select>
            <span asp-validation-for="Specialization" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Phone" class="form-label fw-semibold"></label>
            <input asp-for="Phone" class="form-control" placeholder="01xxxxxxxxx" />
            <span asp-validation-for="Phone" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-check-lg"></i> Save
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}